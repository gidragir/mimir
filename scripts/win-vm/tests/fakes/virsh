#!/usr/bin/env bash
# Фейк virsh для тестов win-vm. Каждый вызов — строка в $FAKE_VIRSH_LOG.
# Управление: FAKE_VM_STATE (running|"shut off"|missing), FAKE_AGENT=down, FAKE_EXIT, FAKE_OUT,
# FAKE_ON_EXEC — скрипт-гость: получает JSON аргументов guest-exec, его stdout — out-data, код — exitcode.
set -u
args=("$@")
if [[ ${args[0]:-} == -c ]]; then args=("${args[@]:2}"); fi
cmd=${args[0]:-}
printf '%s\n' "${args[*]}" >>"${FAKE_VIRSH_LOG:?}"
state_file="$FAKE_VIRSH_LOG.exec"
vm_state_file="$FAKE_VIRSH_LOG.vmstate"
snaps_file="$FAKE_VIRSH_LOG.snaps"
[[ -e $snaps_file ]] || tr ' ' '\n' <<<"${FAKE_SNAPSHOTS:-}" >"$snaps_file"
vm_state() { if [[ -e $vm_state_file ]]; then cat "$vm_state_file"; else echo "${FAKE_VM_STATE:-running}"; fi; }

case "$cmd" in
  dominfo)
    [[ $(vm_state) == missing ]] && { echo "error: failed to get domain '${args[1]:-}'" >&2; exit 1; }
    echo "State:          $(vm_state)"
    ;;
  domstate) vm_state ;;
  start) echo running >"$vm_state_file" ;;
  shutdown | destroy) echo "shut off" >"$vm_state_file" ;;
  dumpxml) echo "<domain><os><nvram template='/usr/share/edk2/x64/OVMF_VARS.4m.fd'>${FAKE_NVRAM:-/var/lib/libvirt/qemu/nvram/win11_VARS.fd}</nvram></os></domain>" ;;
  snapshot-list) rg -v '^$' "$snaps_file" || true ;;
  snapshot-create-as) echo "${args[2]}" >>"$snaps_file" ;;
  qemu-agent-command)
    json=${args[2]}
    exe=$(jq -r .execute <<<"$json")
    case "$exe" in
      guest-ping)
        if [[ ${FAKE_AGENT:-up} == down ]]; then echo "error: Guest agent is not responding" >&2; exit 1; fi
        echo '{"return":{}}'
        ;;
      guest-exec)
        code=${FAKE_EXIT:-0}
        out=${FAKE_OUT:-}
        if [[ -n ${FAKE_ON_EXEC:-} ]]; then
          code=0
          out=$("$FAKE_ON_EXEC" "$(jq -c .arguments <<<"$json")") || code=$?
        fi
        printf '%s\n%s' "$code" "$out" >"$state_file"
        echo '{"return":{"pid":42}}'
        ;;
      guest-exec-status)
        code=0 out=""
        if [[ -e $state_file ]]; then
          code=$(head -n1 "$state_file")
          out=$(tail -n +2 "$state_file")
        fi
        jq -cn --argjson code "$code" --arg out "$(printf '%s' "$out" | base64 -w0)" \
          '{return:{exited:true,exitcode:$code,"out-data":$out}}'
        ;;
      *) echo "fake virsh: unknown agent command $exe" >&2; exit 1 ;;
    esac
    ;;
  *) ;;
esac
exit 0
